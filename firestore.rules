// Firestore Security Rules for HouseholdApp
//
// Paste this into the Firebase Console:
//   Build → Firestore Database → Rules → paste → Publish
//
// Access model:
//  - A user may read/write documents inside a household only if their UID
//    is listed in that household's memberIds array.
//  - Anyone signed in can read an invite code (to look up the household ID
//    when joining) but only members of the household can delete/rotate it.
//  - A user can always create their first household (must include themselves
//    as the sole member and ownerId).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the signed-in user a member of the given household?
    function isMember(householdId) {
      return request.auth != null &&
             request.auth.uid in
               get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // ── households/{id} ────────────────────────────────────────────────────
    match /households/{householdId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;

      // Creating a household: the caller must be signed in, include themselves
      // as the sole member, and set themselves as the owner.
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.memberIds.size() == 1 &&
                       request.resource.data.memberIds[0] == request.auth.uid;

      // Updates: members may update. Joining (arrayUnion on memberIds) is
      // allowed for any signed-in user — the invite flow will have verified
      // the code before calling this. A self-join may ONLY touch memberIds
      // (so a joiner can't simultaneously rewrite ownerId, names, etc.).
      allow update: if request.auth != null && (
                       request.auth.uid in resource.data.memberIds ||
                       // Allow self-join: adding only yourself to memberIds,
                       // changing nothing else.
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
                        request.resource.data.memberIds.size() ==
                          resource.data.memberIds.size() + 1 &&
                        request.auth.uid in request.resource.data.memberIds)
                    );

      // Allow delete if owner, or if the user is the last remaining member
      // (last member leaving triggers full household cleanup from the client).
      allow delete: if request.auth != null && (
                       request.auth.uid == resource.data.ownerId ||
                       (resource.data.memberIds.size() == 1 &&
                        resource.data.memberIds[0] == request.auth.uid)
                    );

      // Subcollections: chores, categories, completions, shoppingItems
      match /chores/{choreId} {
        allow read, write: if isMember(householdId);
      }
      match /categories/{categoryId} {
        allow read, write: if isMember(householdId);
      }
      match /completions/{logId} {
        allow read, write: if isMember(householdId);
      }
      match /shoppingItems/{itemId} {
        allow read, write: if isMember(householdId);
      }
      match /meals/{mealId} {
        allow read, write: if isMember(householdId);
      }
      match /savedMeals/{savedMealId} {
        allow read, write: if isMember(householdId);
      }
      match /trips/{tripId} {
        allow read, write: if isMember(householdId);
      }
      match /packingItems/{itemId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ── invites/{code} ─────────────────────────────────────────────────────
    // Any signed-in user can read an invite (needed to look up the household
    // when joining). Creation is restricted to prevent invite forgery — a
    // user must not be able to create /invites/{code} pointing at a household
    // they don't belong to and then "legitimately" self-join it.
    //
    // Two legal create paths:
    //   1. Same-batch household creation: getAfter() sees the household doc
    //      being written in this batch; caller must be its owner.
    //   2. Rotating a code on an existing household: caller must be a member.
    match /invites/{code} {
      // get-by-code only. `list` stays denied so a signed-in user cannot
      // query the whole collection and enumerate every household's code.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && (
                       getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == request.auth.uid ||
                       isMember(request.resource.data.householdId)
                    );
      allow delete: if request.auth != null &&
                       isMember(resource.data.householdId);
      allow update: if false;
    }
  }
}
