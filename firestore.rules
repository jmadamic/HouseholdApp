// Firestore Security Rules for HouseholdApp
//
// Deploy with: firebase deploy --only firestore:rules
//
// Access model:
//  - A user may read/write documents inside a household only if their UID
//    is listed in that household's memberIds array.
//  - Anyone signed in can read an invite code (to look up the household ID
//    when joining) but only members of the household can delete/rotate it.
//  - Joining requires presenting the household's current invite code.
//  - A user can always create their first household (must include themselves
//    as the sole member and ownerId).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the signed-in user a member of the given household?
    function isMember(householdId) {
      return request.auth != null &&
             request.auth.uid in
               get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // ── households/{id} ────────────────────────────────────────────────────
    match /households/{householdId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.memberIds;

      // Creating a household: the caller must be signed in, include themselves
      // as the sole member, and set themselves as the owner.
      allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.memberIds.size() == 1 &&
                       request.resource.data.memberIds[0] == request.auth.uid;

      // Updates, two paths:
      //  1. A member may update, but can't change the owner, and the only
      //     change they can make to memberIds is removing themselves (leave).
      //  2. Self-join: a signed-in non-member adds ONLY themselves, removes
      //     nobody, and must present the household's current invite code as
      //     `joinCodes.<their uid>`. Rules can't see what the client looked
      //     up, so this is the proof: without it, anyone who ever learned the
      //     household's document ID could join, or rejoin after the code was
      //     changed. It is keyed by uid (and a joiner may only touch their
      //     own key) because a single shared field would still hold the last
      //     joiner's code, letting the next account join without one.
      allow update: if request.auth != null && (
                       (request.auth.uid in resource.data.memberIds &&
                        request.resource.data.ownerId == resource.data.ownerId &&
                        (request.resource.data.memberIds == resource.data.memberIds ||
                         request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]))) ||
                       (!(request.auth.uid in resource.data.memberIds) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinCodes']) &&
                        request.resource.data.joinCodes.diff(resource.data.get('joinCodes', {})).affectedKeys().hasOnly([request.auth.uid]) &&
                        request.resource.data.joinCodes[request.auth.uid] == resource.data.inviteCode &&
                        request.resource.data.memberIds.size() ==
                          resource.data.memberIds.size() + 1 &&
                        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
                        request.auth.uid in request.resource.data.memberIds)
                    );

      // Allow delete if owner, or if the user is the last remaining member
      // (last member leaving triggers full household cleanup from the client).
      allow delete: if request.auth != null && (
                       request.auth.uid == resource.data.ownerId ||
                       (resource.data.memberIds.size() == 1 &&
                        resource.data.memberIds[0] == request.auth.uid)
                    );

      // Subcollections: chores, categories, completions, shoppingItems
      match /chores/{choreId} {
        allow read, write: if isMember(householdId);
      }
      match /categories/{categoryId} {
        allow read, write: if isMember(householdId);
      }
      match /completions/{logId} {
        allow read, write: if isMember(householdId);
      }
      match /shoppingItems/{itemId} {
        allow read, write: if isMember(householdId);
      }
      match /meals/{mealId} {
        allow read, write: if isMember(householdId);
      }
      match /savedMeals/{savedMealId} {
        allow read, write: if isMember(householdId);
      }
      match /trips/{tripId} {
        allow read, write: if isMember(householdId);
      }
      match /packingItems/{itemId} {
        allow read, write: if isMember(householdId);
      }
      match /gardenPlants/{plantId} {
        allow read, write: if isMember(householdId);
      }
      match /wishes/{wishId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ── invites/{code} ─────────────────────────────────────────────────────
    // Any signed-in user can read an invite (needed to look up the household
    // when joining). Creation is restricted to prevent invite forgery — a
    // user must not be able to create /invites/{code} pointing at a household
    // they don't belong to and then "legitimately" self-join it.
    //
    // Two legal create paths:
    //   1. Same-batch household creation: getAfter() sees the household doc
    //      being written in this batch; caller must be its owner.
    //   2. Rotating a code on an existing household: caller must be a member.
    match /invites/{code} {
      // get-by-code only. `list` stays denied so a signed-in user cannot
      // query the whole collection and enumerate every household's code.
      allow get: if request.auth != null;
      allow list: if false;
      // The invite's ID must be the household's own (post-write) inviteCode,
      // so a member can't mint extra codes that outlive a code change.
      allow create: if request.auth != null &&
                       getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code && (
                       getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == request.auth.uid ||
                       isMember(request.resource.data.householdId)
                    );
      allow delete: if request.auth != null &&
                       isMember(resource.data.householdId);
      allow update: if false;
    }
  }
}
